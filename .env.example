# --- Local development (recommended) ---
# Do **not** set VITE_API_BASE_URL so the app calls `/api/...` on the dev server and Vite proxies
# to Railway (no CORS preflight from the browser). Socket.IO uses the same origin + `/socket.io`.
#
# **Cookies:** `fetch` uses `credentials: 'include'`. The proxy rewrites Set-Cookie (drops Domain/Secure, SameSite=Lax)
# so httpOnly cookies from the API can be stored for http://localhost. Disable with: VITE_DEV_PROXY_REWRITE_COOKIES=false
#
# Optional: proxy to a different backend than production:
# VITE_DEV_PROXY_TARGET=https://your-preview.up.railway.app

# If login returns 502 and the terminal shows TLS/cert errors, try (dev only):
# VITE_DEV_PROXY_SECURE=false

# Bearer-only debugging (skips sending cookies):
# VITE_FETCH_CREDENTIALS=omit

# --- Production build / hit API directly from the browser ---
# Set at deploy time. With cookies, the API must send:
#   Access-Control-Allow-Origin: <exact frontend origin>   (not *)
#   Access-Control-Allow-Credentials: true
# and Set-Cookie: Secure; SameSite=None for cross-site cookies (HTTPS only).
# VITE_API_BASE_URL=https://bizxflow-production.up.railway.app

# OpenAPI: {VITE_API_BASE_URL}/api-docs when using absolute base; in dev proxy use the Railway host in the browser.

# Optional: comma-separated Socket.io event names for new notifications (default: notification).
# VITE_NOTIFICATION_SOCKET_EVENTS=notification

# Optional: poll notification REST this often (ms), min 15000 — helps when Socket.io misses (e.g. company inbox).
# VITE_NOTIFICATION_POLL_MS=30000
